# ==========================================
# SyBorx-Messenger Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# Database (PostgreSQL via Docker)
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_NAME=syborx_messenger_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/syborx_messenger_db?schema=public"

# JWT Authentication
JWT_SECRET=syborx_messenger_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=syborx_messenger_refresh_super_secret_key_2026_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=25

# Corporate Domain Config (Optional restriction)
ALLOWED_CORP_DOMAIN=syborx.com
ALLOW_GMAIL_TESTING=true

# Future Features Prep (WebRTC & AI)
# OPENAI_API_KEY=
# WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
